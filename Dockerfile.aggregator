FROM eclipse-temurin:21-jdk AS builder
WORKDIR /build
COPY . .
RUN ./gradlew :aggregator:installDist --no-daemon

FROM eclipse-temurin:21-jre-jammy
WORKDIR /app

# Playwright/Chromium system dependencies (Ubuntu 22.04 package names)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 libnss3 libnspr4 libdbus-1-3 libatk1.0-0 \
    libatk-bridge2.0-0 libcups2 libdrm2 libxkbcommon0 \
    libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
    libgbm1 libasound2 libpango-1.0-0 libcairo2 \
    libx11-6 libxext6 libxcb1 libx11-xcb1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/aggregator/build/install/aggregator .

CMD ["bin/aggregator"]
